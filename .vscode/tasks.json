// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "pnpm: watch",
			"type": "shell",
			"command": "pnpm",
			"args": ["run", "watch"],
			"problemMatcher": {
				"owner": "webpack",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*$",
					"endsPattern": "compiled successfully"
				}
			},
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "pnpm: watch-tests",
			"type": "shell",
			"command": "pnpm",
			"args": ["run", "watch-tests"],
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": "build"
		},
		{
			"label": "tasks: watch-tests",
			"dependsOn": [
				"pnpm: watch",
				"pnpm: watch-tests"
			],
			"problemMatcher": []
		}
	]
}
